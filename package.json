{
  "name": "@edgaralochi/yada",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "demo": "node --import tsx examples/basic.ts",
    "demo:live": "node --env-file-if-exists=.env --import tsx examples/live.ts",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "test:deployment": "node scripts/deployment-smoke.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.6.0",
    "@langchain/core": "1.3.2",
    "@langchain/google-genai": "2.3.4",
    "@langchain/openai": "1.8.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "better-sqlite3": "13.0.3",
    "knex": "3.3.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/widget/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "description": "TypeScript runtime for in-app AI assistants, with typed tools, configurable providers, approvals, and durable conversations.",
  "license": "MIT",
  "author": "Edgar Alochi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgar4/yada.git"
  },
  "homepage": "https://yada.edgar.co.ke",
  "bugs": {
    "url": "https://github.com/edgar4/yada/issues"
  },
  "keywords": [
    "ai",
    "ai-agent",
    "ai-assistant",
    "chatbot",
    "llm",
    "mcp",
    "typescript",
    "tool-calling"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
