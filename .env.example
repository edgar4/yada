YADA_LLM_PROVIDER=anthropic
YADA_LLM_MODEL=claude-opus-5-5
YADA_LLM_API_KEY=

# Optional. Every provider accepts these; ones it doesn't support are ignored.
# YADA_LLM_EFFORT=high                      # low | medium | high | xhigh | max
# YADA_LLM_TEMPERATURE=0.7                  # 0 to 2
# YADA_LLM_MAX_TOKENS=8192
# YADA_LLM_PROMPT_CACHE=5m                  # 5m | 1h | off
# YADA_LLM_SERVER_TOOLS=web_search          # web_search (default), code_execution, or none
