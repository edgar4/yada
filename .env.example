YADA_LLM_PROVIDER=anthropic
YADA_LLM_MODEL=claude-opus-5-5
YADA_LLM_API_KEY=

# Optional. Every provider accepts these; ones it doesn't support are ignored.
# YADA_LLM_EFFORT=high                      # low | medium | high | xhigh | max
# YADA_LLM_TEMPERATURE=0.7                  # 0 to 2
# YADA_LLM_MAX_TOKENS=8192
# YADA_LLM_PROMPT_CACHE=5m                  # 5m | 1h | off
# YADA_LLM_SERVER_TOOLS=web_search          # web_search (default), code_execution, or none
# YADA_LLM_WEB_SEARCH_MAX_USES=5
# YADA_LLM_WEB_SEARCH_DOMAINS=docs.example.com,example.org
# YADA_LLM_THINKING_DISPLAY=summarized      # summarized | omitted
# YADA_LLM_VISION=true                      # local and compatible servers
# YADA_LLM_FALLBACK_MODEL=                  # same provider, used on overload or outage
# YADA_LLM_TIMEOUT_MS=120000
# YADA_LLM_MAX_RETRIES=2
# YADA_LLM_BASE_URL=                        # proxy, gateway or local server
# YADA_LLM_HEADERS={"x-team":"yada"}

# OpenAI-compatible server example:
# YADA_LLM_PROVIDER=openai-compatible
# YADA_LLM_MODEL=vendor/model
# YADA_LLM_BASE_URL=https://gateway.example.com/v1
# YADA_LLM_API_KEY=

# Storage (starter and service). `npm run starter:init` adds YADA_STORAGE_KEY.
# YADA_STORAGE_DRIVER=sqlite                # sqlite | postgres | mysql
# YADA_STORAGE_FILE=work/starter/yada.sqlite
# YADA_STORAGE_URL=
# YADA_STORAGE_PREVIOUS_KEYS=               # comma-separated old keys during rotation
# YADA_MCP_SERVERS=
